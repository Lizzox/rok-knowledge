{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rok-knowledge/schemas/guide-schema.json",
  "title": "Guide",
  "description": "Schema for a strategy/how-to guide knowledge document.",
  "type": "object",
  "required": ["id", "name", "category", "section", "tags", "last_updated", "sources", "detail_status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "category": { "type": "string", "enum": ["guide"] },
    "section": {
      "type": "string",
      "enum": ["beginner", "progression", "economy", "combat", "kvk", "events", "advanced"]
    },
    "audience": { "type": "string", "enum": ["new-player", "growing-kingdom", "mature-kingdom", "all"] },
    "summary": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "detail_status": { "type": "string", "enum": ["complete", "partial", "stub-pending-research"] },
    "last_updated": { "type": "string", "format": "date" },
    "sources": { "type": "array", "items": { "type": "string" } }
  }
}
