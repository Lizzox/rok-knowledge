{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rok-knowledge/schemas/equipment-schema.json",
  "title": "Equipment",
  "description": "Schema for a piece of RoK equipment (gear) knowledge document.",
  "type": "object",
  "required": ["id", "name", "category", "slot", "rarity", "tags", "last_updated", "sources", "detail_status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "category": { "type": "string", "enum": ["equipment"] },
    "slot": { "type": "string", "enum": ["Helmet", "Chestplate", "Weapon", "Boots", "Belt", "Ring", "Necklace"] },
    "rarity": { "type": "string", "enum": ["Green", "Blue", "Purple", "Gold", "Legendary"] },
    "material_source": { "type": "array", "items": { "type": "string" } },
    "set": { "type": "string" },
    "best_for": { "type": "array", "items": { "type": "string" } },
    "stats": { "type": "object" },
    "special_effect": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "detail_status": { "type": "string", "enum": ["complete", "partial", "stub-pending-research"] },
    "last_updated": { "type": "string", "format": "date" },
    "sources": { "type": "array", "items": { "type": "string" } }
  }
}
