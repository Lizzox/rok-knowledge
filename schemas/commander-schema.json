{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rok-knowledge/schemas/commander-schema.json",
  "title": "Commander",
  "description": "Schema for a Rise of Kingdoms commander knowledge document.",
  "type": "object",
  "required": ["id", "name", "category", "rarity", "civilization", "specialties", "tags", "last_updated", "sources", "detail_status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Kebab-case unique identifier, e.g. 'zhuge-liang'" },
    "name": { "type": "string" },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "category": { "type": "string", "enum": ["commander"] },
    "rarity": { "type": "string", "enum": ["Legendary", "Epic", "Elite", "Advanced"] },
    "civilization": { "type": "string" },
    "release_date": { "type": "string", "description": "ISO date or 'unknown'" },
    "specialties": {
      "type": "array",
      "items": { "type": "string", "enum": ["Infantry", "Cavalry", "Archer", "Leadership", "Skill", "Garrison", "Support", "Conquering", "Peace-time Skills"] },
      "minItems": 1
    },
    "role": { "type": "array", "items": { "type": "string" } },
    "troop_type": { "type": "string", "enum": ["Infantry", "Cavalry", "Archer", "Leadership", "Siege", "Mixed"] },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "type"],
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string", "enum": ["Active", "Passive", "Mastery"] },
          "unlock_star": { "type": "integer" },
          "effect_summary": { "type": "string" },
          "damage_factor": { "type": "string" },
          "rage_cost": { "type": "integer" }
        }
      }
    },
    "expertise": { "type": "array", "items": { "type": "string" } },
    "best_pairings": { "type": "array", "items": { "type": "string" } },
    "alternative_pairings": { "type": "array", "items": { "type": "string" } },
    "recommended_equipment": { "type": "array", "items": { "type": "string" } },
    "recommended_armaments": { "type": "array", "items": { "type": "string" } },
    "usage": {
      "type": "object",
      "properties": {
        "open_field": { "type": "string" },
        "rally": { "type": "string" },
        "garrison": { "type": "string" },
        "farming": { "type": "string" }
      }
    },
    "strengths": { "type": "array", "items": { "type": "string" } },
    "weaknesses": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "detail_status": {
      "type": "string",
      "enum": ["complete", "partial", "stub-pending-research"],
      "description": "Honest marker of how much of this record has been verified/filled in."
    },
    "last_updated": { "type": "string", "format": "date" },
    "sources": { "type": "array", "items": { "type": "string" } }
  }
}
