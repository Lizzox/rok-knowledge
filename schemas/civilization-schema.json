{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rok-knowledge/schemas/civilization-schema.json",
  "title": "Civilization",
  "description": "Schema for a Rise of Kingdoms civilization knowledge document.",
  "type": "object",
  "required": ["id", "name", "category", "tags", "last_updated", "sources", "detail_status"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string" },
    "category": { "type": "string", "enum": ["civilization"] },
    "bonuses": { "type": "array", "items": { "type": "string" } },
    "best_for": { "type": "array", "items": { "type": "string" } },
    "starting_commander": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "detail_status": { "type": "string", "enum": ["complete", "partial", "stub-pending-research"] },
    "last_updated": { "type": "string", "format": "date" },
    "sources": { "type": "array", "items": { "type": "string" } }
  }
}
